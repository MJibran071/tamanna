# ─── Tamanna AI Voice Assistant ───
# Copy this file to .env and fill in your values.

# Database (SQLite — defaults to db/custom.db)
DATABASE_URL=file:./db/custom.db

# Voice Stack Service (default: http://localhost:3010)
VOICE_STACK_URL=http://localhost:3010

# ─── Optional: AI Provider Keys ───
# Uncomment and set these if using external AI providers
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
